{% extends 'layout/app.html.twig' %}

{% block title %}Mon profil{% endblock %}
{% block page_subtitle %}Vos informations personnelles et vos accès.{% endblock %}
{% block breadcrumb %}<li class="breadcrumb-item active">Mon profil</li>{% endblock %}

{% block content %}
<div class="row g-3">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header"><h2 class="card-title">Informations personnelles</h2></div>
            <div class="card-body">
                {{ form_start(form) }}
                    <div class="mb-3">
                        <label class="form-label">E-mail de connexion</label>
                        <input class="form-control" value="{{ user.email }}" disabled>
                    </div>
                    <div class="row">
                        <div class="col-md-6">{{ form_row(form.prenoms) }}</div>
                        <div class="col-md-6">{{ form_row(form.nom) }}</div>
                        <div class="col-md-6">{{ form_row(form.telephone) }}</div>
                        <div class="col-md-6">{{ form_row(form.langue) }}</div>
                    </div>
                    <div class="d-flex gap-2 mt-2">
                        <button class="btn btn-primary">Enregistrer</button>
                        <a href="{{ path('app_compte_mot_de_passe') }}" class="btn btn-light-subtle"><i class="bi bi-key me-1"></i>Changer mon mot de passe</a>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header"><h2 class="card-title">Mes sociétés</h2></div>
            <ul class="list-group list-group-flush">
                {% for s in user.succursalesAdministrees %}
                    <li class="list-group-item d-flex align-items-center gap-2 py-3">
                        <span class="avatar avatar-sm avatar-square">{{ s.initiales }}</span>
                        <div class="flex-grow-1">
                            <div class="fw-medium">{{ s.nom }}</div>
                            <div class="small text-body-secondary">{{ s.societes|length }} société(s) {% for p in s.pays %}{{ p.drapeau }}{% endfor %}</div>
                        </div>
                        <span class="badge text-bg-danger badge-soft">Administrateur</span>
                    </li>
                {% endfor %}
                {% for m in user.membres %}
                    <li class="list-group-item d-flex align-items-center gap-2 py-3">
                        {% include 'societe/_logo.html.twig' with {societe: m.societe, taille: 'sm'} %}
                        <div class="flex-grow-1">
                            <div class="fw-medium">{{ m.societe.raisonSociale }}</div>
                            <div class="small text-body-secondary">{{ m.societe.pays.drapeau }} {{ m.societe.pays.nom }}</div>
                        </div>
                        <span class="badge text-bg-{{ m.role.couleur }} badge-soft">{{ m.role.libelle }}</span>
                        {% if not m.actif %}<span class="badge text-bg-secondary badge-soft">Suspendu</span>{% endif %}
                    </li>
                {% else %}
                    {% if user.superAdmin %}
                        <li class="list-group-item text-body-secondary small py-3">Super-administrateur : accès à toutes les sociétés.</li>
                    {% elseif user.succursalesAdministrees is empty %}
                        <li class="list-group-item text-body-secondary small py-3">Aucune société.</li>
                    {% endif %}
                {% endfor %}
            </ul>
            <div class="card-body border-top small text-body-secondary">
                Dernière connexion : {{ user.derniereConnexion ? user.derniereConnexion|date('d/m/Y à H:i') : '—' }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
