{% extends 'layout/app.html.twig' %}

{% block title %}Modifier la société{% endblock %}
{% block page_subtitle %}{{ societe.raisonSociale }}{% endblock %}
{% block breadcrumb %}<li class="breadcrumb-item"><a href="{{ path('app_ma_societe') }}">Ma société</a></li><li class="breadcrumb-item active">Modifier</li>{% endblock %}

{% block content %}
<div class="card">
    <div class="card-body">
        {{ form_start(form) }}
            {{ form_errors(form) }}
            {% include 'societe/_form.html.twig' %}
            <div class="small text-body-secondary mt-n2 mb-3"><i class="bi bi-info-circle me-1"></i>Le changement de pays se fait auprès du support de la plateforme.</div>
            <div class="d-flex gap-2 mt-4">
                <button class="btn btn-primary">Enregistrer</button>
                <a href="{{ path('app_ma_societe') }}" class="btn btn-light-subtle">Annuler</a>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
