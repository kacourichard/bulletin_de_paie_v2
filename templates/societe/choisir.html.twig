{% extends 'layout/app.html.twig' %}

{% block title %}Choisir une société{% endblock %}
{% block page_subtitle %}Sélectionnez la société sur laquelle vous souhaitez travailler.{% endblock %}
{% block breadcrumb %}<li class="breadcrumb-item active">Choisir une société</li>{% endblock %}

{% block content %}
{% set courante = societe_courante() %}
{# Sociétés regroupées par succursale (ordre alphabétique), pour les retrouver vite. #}
{% set groupes = {} %}
{% for s in societes|sort((a, b) => a.succursale.nom|lower <=> b.succursale.nom|lower ?: a.raisonSociale|lower <=> b.raisonSociale|lower) %}
    {% set cle = 's' ~ s.succursale.id %}
    {% set groupes = groupes|merge({(cle): {succursale: s.succursale, societes: (groupes[cle].societes ?? [])|merge([s])}}) %}
{% endfor %}

{% if societes|length > 6 %}
    <div class="mb-3" style="max-width: 360px;">
        <input type="search" class="form-control" placeholder="Rechercher une société ou une succursale…" aria-label="Rechercher une société" data-filtre-lignes="#choix-societes" autofocus>
    </div>
{% endif %}

<div id="choix-societes">
{% for g in groupes %}
    <section class="mb-4" data-filtre-groupe>
        {% if groupes|length > 1 %}
            <h2 class="h6 text-body-secondary text-uppercase mb-2"><i class="bi bi-diagram-3 me-1"></i>{{ g.succursale.nom }} <span class="fw-normal">· {{ g.societes|length }}</span></h2>
        {% endif %}
        <div class="row g-3">
            {% for s in g.societes %}
                {% set membre = app.user.membrePour(s) %}
                <div class="col-md-6 col-xl-4" data-filtre-ligne>
                    <span class="visually-hidden">{{ g.succursale.nom }}</span>
                    <form method="post" action="{{ path('app_societe_basculer', {id: s.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('basculer-societe') }}">
                        <button class="societe-tile">
                            {% include 'societe/_logo.html.twig' with {societe: s, taille: 'lg'} %}
                            <span class="flex-grow-1 overflow-hidden">
                                <span class="d-block fw-semibold text-truncate">{{ s.raisonSociale }}</span>
                                <span class="d-block small text-body-secondary">{{ s.pays.drapeau }} {{ s.pays.nom }} · {{ s.deviseEffective }}</span>
                                {% if membre %}<span class="badge text-bg-{{ membre.role.couleur }} badge-soft mt-1">{{ membre.role.libelle }}</span>{% endif %}
                            </span>
                            {% if courante and courante.id == s.id %}
                                <i class="bi bi-check-circle-fill text-primary fs-5"></i>
                            {% else %}
                                <i class="bi bi-chevron-right text-body-secondary"></i>
                            {% endif %}
                        </button>
                    </form>
                </div>
            {% endfor %}
        </div>
    </section>
{% else %}
    <div class="card"><div class="empty-state"><i class="bi bi-buildings"></i>Vous n'êtes rattaché(e) à aucune société active.</div></div>
{% endfor %}
    <div class="card" data-filtre-aucun hidden><div class="empty-state"><i class="bi bi-search"></i>Aucune société ne correspond à la recherche.</div></div>
</div>
{% endblock %}
