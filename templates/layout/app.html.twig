{% extends 'base.html.twig' %}

{#
    Gabarit de l'espace connecté. Les pages définissent :
      - page_title / page_subtitle / page_actions : en-tête de page
      - breadcrumb : éléments du fil d'Ariane (sous forme de <li>)
      - content : contenu principal
#}
{% block body %}
    {% include 'layout/_sidebar.html.twig' %}
    <div class="app-backdrop"></div>

    <div class="app-main">
        {% include 'layout/_topbar.html.twig' with {breadcrumb_html: block('breadcrumb')} %}

        <main class="app-content">
            {% include 'layout/_flashes.html.twig' %}

            {% block page_header %}
                <div class="page-header">
                    <div>
                        <h1 class="page-title">{% block page_title %}{{ block('title') }}{% endblock %}</h1>
                        {% set sous_titre = block('page_subtitle') is defined ? block('page_subtitle')|trim : '' %}
                        {% if sous_titre %}<p class="page-subtitle">{{ sous_titre|raw }}</p>{% endif %}
                    </div>
                    <div class="d-flex flex-wrap gap-2">{% block page_actions %}{% endblock %}</div>
                </div>
            {% endblock %}

            {% block content %}{% endblock %}
        </main>
    </div>
{% endblock %}

{% block page_subtitle %}{% endblock %}
{% block breadcrumb %}{% endblock %}
