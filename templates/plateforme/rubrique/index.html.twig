{% extends 'layout/app.html.twig' %}

{% block title %}Rubriques — {{ pays.nom }}{% endblock %}
{% block page_title %}{{ pays.drapeau }} Rubriques de paie — {{ pays.nom }}{% endblock %}
{% block page_subtitle %}Lignes du bulletin et leur traitement social et fiscal. Les avantages des salariés de ce pays sont choisis parmi les rubriques de gain marquées « avantage ».{% endblock %}
{% block breadcrumb %}<li class="breadcrumb-item">Plateforme</li><li class="breadcrumb-item"><a href="{{ path('app_plateforme_pays') }}">Pays</a></li><li class="breadcrumb-item active">Rubriques {{ pays.nom }}</li>{% endblock %}
{% block page_actions %}
    <a href="{{ path('app_plateforme_rubrique_nouvelle', {pays: pays.id}) }}" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Nouvelle rubrique</a>
{% endblock %}

{% block content %}
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover" data-controller="datatable">
            <thead><tr><th>Code</th><th>Libellé</th><th>Type</th><th>Position</th><th>Traitement social</th><th>Traitement fiscal</th><th>Fixe</th><th>Variable</th><th class="text-end">Utilisée</th><th></th></tr></thead>
            <tbody>
            {% for r in rubriques %}
                <tr class="{{ not r.actif ? 'text-body-secondary' }}">
                    <td class="font-monospace fw-semibold">{{ r.code }}</td>
                    <td>{{ r.libelle }}{% if not r.actif %} <span class="badge text-bg-secondary badge-soft">Inactive</span>{% endif %}</td>
                    <td>{% if r.gain %}<span class="badge text-bg-success badge-soft">Gain</span>{% else %}<span class="badge text-bg-danger badge-soft">Retenue</span>{% endif %}</td>
                    <td class="text-center">{{ r.section.value }}</td>
                    <td class="small">{{ r.traitementSocial.libelle }}</td>
                    <td class="small">{{ r.traitementFiscalDetaille }}</td>
                    <td>{% if r.elementFixe %}<i class="bi bi-check-lg text-success"></i>{% if not r.proratisee %} <span class="badge text-bg-warning badge-soft" title="Montant dû en entier, sans prorata des jours">sans prorata</span>{% endif %}{% else %}<span class="text-body-secondary">—</span>{% endif %}</td>
                    <td>{% if r.elementVariable %}<i class="bi bi-check-lg text-success"></i>{% else %}<span class="text-body-secondary">—</span>{% endif %}</td>
                    <td class="text-end small">{{ utilisations[r.id] ?? 0 }}</td>
                    <td class="text-end"><a href="{{ path('app_plateforme_rubrique_modifier', {pays: pays.id, id: r.id}) }}" class="btn btn-sm btn-light-subtle">Modifier</a></td>
                </tr>
            {% else %}
                <tr><td colspan="10"><div class="empty-state"><i class="bi bi-list-columns"></i>Aucune rubrique pour ce pays : les sociétés ne peuvent pas encore attribuer d'avantages.</div></td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    <div class="card-body border-top small text-body-secondary">
        Position : 1 = éléments soumis (brut imposable) · 2 = cotisations salariales · 3 = éléments non soumis.
        Une rubrique utilisée ne peut pas être supprimée : désactivez-la pour qu'elle ne soit plus proposée.
    </div>
</div>
{% endblock %}
