{% extends 'layout/app.html.twig' %}

{% block title %}Sociétés{% endblock %}
{% block page_subtitle %}Toutes les sociétés clientes de la plateforme, regroupées par succursale.{% endblock %}
{% block breadcrumb %}<li class="breadcrumb-item">Plateforme</li><li class="breadcrumb-item active">Sociétés</li>{% endblock %}
{% block page_actions %}
    <a href="{{ path('app_plateforme_societe_nouvelle') }}" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Nouvelle société</a>
{% endblock %}

{% block content %}
<div class="card mb-3">
    <div class="card-header flex-wrap gap-2">
        <form method="get" class="d-flex flex-wrap gap-2">
            <select name="succursale" class="form-select" style="min-width: 240px; max-width: 260px;" onchange="this.form.submit()" aria-label="Succursale">
                <option value="">Toutes les succursales</option>
                {% for s in listeSuccursales %}
                    <option value="{{ s.id }}"{{ succursaleFiltre == s.id ? ' selected' }}>{{ s.nom }}</option>
                {% endfor %}
            </select>
            <select name="pays" class="form-select" style="min-width: 240px; max-width: 260px;" onchange="this.form.submit()" aria-label="Pays">
                <option value="">Tous les pays</option>
                {% for p in listePays %}
                    <option value="{{ p.id }}"{{ paysFiltre == p.id ? ' selected' }}>{{ p.drapeau }} {{ p.nom }}</option>
                {% endfor %}
            </select>
            <input type="search" class="form-control" style="max-width: 260px;" placeholder="Rechercher une société…" aria-label="Rechercher une société" data-filtre-lignes="#groupes-societes">
        </form>
        <span class="small text-body-secondary">{{ nbSocietes }} société(s) · {{ groupes|length }} succursale(s)</span>
    </div>
</div>

<div id="groupes-societes">
{% for g in groupes %}
    {% set su = g.succursale %}
    <div class="card mb-3" data-filtre-groupe>
        <div class="card-header">
            <h2 class="card-title">
                <i class="bi bi-diagram-3 me-1 text-body-secondary"></i>
                <a href="{{ path('app_succursale_voir', {id: su.id}) }}" class="text-reset">{{ su.nom }}</a>
                {% if not su.active %}<span class="badge-statut text-secondary ms-1">Inactive</span>{% endif %}
                <span class="small text-body-secondary fw-normal ms-2">{{ g.societes|length }} société(s)</span>
            </h2>
            <a href="{{ path('app_plateforme_societe_nouvelle', {succursale: su.id}) }}" class="btn btn-sm btn-light-subtle"><i class="bi bi-plus-lg me-1"></i>Société</a>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead><tr><th>Société</th><th>Pays</th><th>Devise</th><th class="text-end">Salariés</th><th class="text-end">Équipe</th><th>Statut</th><th></th></tr></thead>
                <tbody>
                {% for s in g.societes %}
                    <tr data-filtre-ligne>
                        <td><div class="d-flex align-items-center gap-2">{% include 'societe/_logo.html.twig' with {societe: s, taille: 'sm'} %}
                            <div><div class="fw-medium">{{ s.raisonSociale }}</div><div class="small text-body-secondary">{{ s.ville }}</div></div></div></td>
                        <td>{{ s.pays.drapeau }} {{ s.pays.nom }}</td>
                        <td class="font-monospace">{{ s.deviseEffective }}</td>
                        <td class="text-end fw-semibold">{{ effectifs[s.id] ?? 0 }}</td>
                        <td class="text-end">{{ s.membres|length }}</td>
                        <td>{% if s.active %}<span class="badge-statut text-success">Active</span>{% else %}<span class="badge-statut text-secondary">Inactive</span>{% endif %}</td>
                        <td class="text-end"><a href="{{ path('app_plateforme_societe_voir', {id: s.id}) }}" class="btn btn-sm btn-light-subtle">Ouvrir</a></td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% else %}
    <div class="card"><div class="empty-state"><i class="bi bi-buildings"></i>Aucune société.</div></div>
{% endfor %}
    <div class="card" data-filtre-aucun hidden><div class="empty-state"><i class="bi bi-search"></i>Aucune société ne correspond à la recherche.</div></div>
</div>
{% endblock %}
