{% extends 'layout/app.html.twig' %}

{% block title %}Succursales{% endblock %}
{% block page_subtitle %}Chaque succursale regroupe des sociétés et est confiée à ses administrateurs.{% endblock %}
{% block breadcrumb %}<li class="breadcrumb-item">Plateforme</li><li class="breadcrumb-item active">Succursales</li>{% endblock %}
{% block page_actions %}
    <a href="{{ path('app_plateforme_utilisateurs', {profil: 'administrateurs'}) }}" class="btn btn-light-subtle"><i class="bi bi-shield-lock me-1"></i>Tous les administrateurs</a>
    <a href="{{ path('app_plateforme_succursale_nouvelle') }}" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Nouvelle succursale</a>
{% endblock %}

{% block content %}
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover" data-controller="datatable">
            <thead><tr><th>Succursale</th><th>Administrateurs</th><th>Sociétés</th><th class="text-end">Salariés</th><th>Pays</th><th>Statut</th><th></th></tr></thead>
            <tbody>
            {% for s in succursales %}
                <tr>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <span class="avatar avatar-sm avatar-square">{{ s.initiales }}</span>
                            <div><div class="fw-medium">{{ s.nom }}</div><div class="small text-body-secondary">{{ s.description }}</div></div>
                        </div>
                    </td>
                    <td class="small">
                        {% for u in s.administrateurs %}
                            <div>{{ u.nomComplet }} <span class="text-body-secondary">· {{ u.email }}</span>{% if not u.actif %} <span class="badge text-bg-danger badge-soft">désactivé</span>{% endif %}</div>
                        {% else %}
                            <span class="text-danger">Aucun</span>
                        {% endfor %}
                    </td>
                    <td>{{ s.societes|length }}</td>
                    <td class="text-end fw-semibold">{{ s.societes|reduce((total, so) => total + (effectifs[so.id] ?? 0), 0) }}</td>
                    <td class="fs-5">{% for p in s.pays %}<span title="{{ p.nom }}">{{ p.drapeau }}</span>{% else %}<span class="small text-body-secondary">—</span>{% endfor %}</td>
                    <td>{% if s.active %}<span class="badge-statut text-success">Active</span>{% else %}<span class="badge-statut text-secondary">Désactivée</span>{% endif %}</td>
                    <td class="text-end"><a href="{{ path('app_succursale_voir', {id: s.id}) }}" class="btn btn-sm btn-light-subtle">Ouvrir</a></td>
                </tr>
            {% else %}
                <tr><td colspan="7"><div class="empty-state"><i class="bi bi-diagram-3"></i>Aucune succursale.</div></td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
