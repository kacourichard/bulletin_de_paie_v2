{% extends 'layout/app.html.twig' %}

{% block title %}Cotisations — {{ pays.nom }}{% endblock %}
{% block page_title %}{{ pays.drapeau }} Cotisations — {{ pays.nom }}{% endblock %}
{% block page_subtitle %}Retenues salariales et charges patronales calculées sur chaque bulletin de ce pays.{% endblock %}
{% block breadcrumb %}<li class="breadcrumb-item">Plateforme</li><li class="breadcrumb-item"><a href="{{ path('app_plateforme_pays') }}">Pays</a></li><li class="breadcrumb-item active">Cotisations {{ pays.nom }}</li>{% endblock %}
{% block page_actions %}
    <a href="{{ path('app_plateforme_parametres_paie', {pays: pays.id}) }}" class="btn btn-light-subtle"><i class="bi bi-calculator me-1"></i>Paramètres de paie</a>
    <a href="{{ path('app_plateforme_cotisation_nouvelle', {pays: pays.id}) }}" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Nouvelle cotisation</a>
{% endblock %}

{% block content %}
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover">
            <thead><tr><th>Cotisation</th><th>Catégorie</th><th>Assiette</th><th class="text-end">Plafond</th><th class="text-end">Salarié</th><th class="text-end">Employeur</th><th>Codes</th><th></th></tr></thead>
            <tbody>
            {% for c in cotisations %}
                <tr class="{{ not c.actif ? 'text-body-secondary' }}">
                    <td class="fw-medium">{{ c.libelle }}{% if not c.actif %} <span class="badge text-bg-secondary badge-soft">Inactive</span>{% endif %}</td>
                    <td><span class="badge text-bg-{{ c.categorie.value == 'FISCALE' ? 'warning' : 'info' }} badge-soft">{{ c.categorie.libelle }}</span></td>
                    <td class="small">{{ c.assiette.libelle }}{% if c.forfaitUnitaire %} ({{ (c.forfaitUnitaire + 0)|number_format(0, ',', ' ') }} / pers.){% endif %}</td>
                    <td class="text-end small">{{ c.plafond ? (c.plafond + 0)|number_format(0, ',', ' ') : '—' }}</td>
                    <td class="text-end">{{ c.tauxSalarial is not null ? (c.tauxSalarial + 0) ~ ' %' : '—' }}</td>
                    <td class="text-end">{{ c.tauxPatronal is not null ? (c.tauxPatronal + 0) ~ ' %' : '—' }}</td>
                    <td class="font-monospace small">{{ c.codeSalarial ?: '—' }} / {{ c.codePatronal ?: '—' }}</td>
                    <td class="text-end"><a href="{{ path('app_plateforme_cotisation_modifier', {pays: pays.id, id: c.id}) }}" class="btn btn-sm btn-light-subtle">Modifier</a></td>
                </tr>
            {% else %}
                <tr><td colspan="8"><div class="empty-state"><i class="bi bi-percent"></i>Aucune cotisation pour ce pays.</div></td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
