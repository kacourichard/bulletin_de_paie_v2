{% extends 'layout/app.html.twig' %}

{% block title %}{{ cotisation.id ? cotisation.libelle : 'Nouvelle cotisation' }}{% endblock %}
{% block page_subtitle %}{{ pays.drapeau }} {{ pays.nom }}{% endblock %}
{% block breadcrumb %}<li class="breadcrumb-item">Plateforme</li><li class="breadcrumb-item"><a href="{{ path('app_plateforme_cotisations', {pays: pays.id}) }}">Cotisations {{ pays.nom }}</a></li><li class="breadcrumb-item active">{{ cotisation.id ? 'Modifier' : 'Nouvelle' }}</li>{% endblock %}

{% block content %}
<div class="card" style="max-width: 900px;">
    <div class="card-body">
        {{ form_start(form) }}
            {{ form_errors(form) }}
            <div class="row">
                <div class="col-md-8">{{ form_row(form.libelle) }}</div>
                <div class="col-md-4">{{ form_row(form.categorie) }}</div>
                <div class="col-md-6">{{ form_row(form.assiette) }}</div>
                <div class="col-md-3">{{ form_row(form.plafond) }}</div>
                <div class="col-md-3">{{ form_row(form.forfaitUnitaire) }}</div>
                <div class="col-md-3">{{ form_row(form.tauxSalarial) }}</div>
                <div class="col-md-3">{{ form_row(form.codeSalarial) }}</div>
                <div class="col-md-3">{{ form_row(form.tauxPatronal) }}</div>
                <div class="col-md-3">{{ form_row(form.codePatronal) }}</div>
                <div class="col-md-3">{{ form_row(form.ordre) }}</div>
                <div class="col-md-6">{{ form_row(form.tauxPatronalNonNational) }}</div>
                <div class="col-md-6 pt-md-4"><div class="form-check">{{ form_widget(form.tauxPatronalSociete) }}{{ form_label(form.tauxPatronalSociete) }}</div></div>
            </div>
            <div class="form-check form-switch mb-3">{{ form_widget(form.actif) }}{{ form_label(form.actif) }}</div>
            <div class="d-flex gap-2">
                <button class="btn btn-primary">Enregistrer</button>
                <a href="{{ path('app_plateforme_cotisations', {pays: pays.id}) }}" class="btn btn-light-subtle">Annuler</a>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
