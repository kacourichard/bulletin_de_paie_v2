{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
<div class="auth-wrapper">
    <section class="auth-aside">
        <div class="d-flex align-items-center gap-3">
            <span class="auth-logo"><img src="{{ asset('images/cipaie-logo.jpg') }}" alt="Côte d'Ivoire Paie"></span>
            <span class="fw-semibold text-white">{{ app_nom }} <span class="brand-version">{{ app_version }}</span></span>
        </div>

        <div>
            <h1 class="mb-3">La paie de vos équipes,<br>dans tous vos pays.</h1>
            <p class="lead mb-5">Gérez vos sociétés, vos salariés et vos bulletins de paie depuis un seul espace, avec des accès adaptés au rôle de chacun.</p>

            <div class="auth-feature">
                <i class="bi bi-globe2"></i>
                <div><strong>Multi-pays, multi-devises</strong><span>Chaque société suit la devise et les règles de son pays.</span></div>
            </div>
            <div class="auth-feature">
                <i class="bi bi-shield-check"></i>
                <div><strong>Rôles et permissions</strong><span>Administrateur, comptable, trésorier… chacun voit ce qui le concerne.</span></div>
            </div>
            <div class="auth-feature">
                <i class="bi bi-buildings"></i>
                <div><strong>Plusieurs sociétés, un seul compte</strong><span>Passez d'une société à l'autre en un clic.</span></div>
            </div>
        </div>

        <div class="small text-secondary">© {{ 'now'|date('Y') }} Côte d'Ivoire Paie — {{ app_nom }} {{ app_version }}</div>
    </section>

    <section class="auth-form">
        <div class="inner">
            <div class="d-lg-none mb-4">
                <img src="{{ asset('images/cipaie-logo.jpg') }}" alt="Côte d'Ivoire Paie" style="height: 64px;">
            </div>

            <h2 class="h3 fw-bold mb-1">Connexion</h2>
            <p class="text-body-secondary mb-4">Entrez vos identifiants pour accéder à votre espace.</p>

            {% if error %}
                <div class="alert alert-danger d-flex gap-2 align-items-center py-2">
                    <i class="bi bi-exclamation-circle"></i>
                    <div>{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                </div>
            {% endif %}

            <form method="post" action="{{ path('app_login') }}">
                <div class="mb-3">
                    <label for="email" class="form-label">Adresse e-mail</label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent"><i class="bi bi-envelope"></i></span>
                        <input type="email" value="{{ last_username }}" name="email" id="email" class="form-control" autocomplete="email" required autofocus placeholder="vous@entreprise.com">
                    </div>
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">Mot de passe</label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent"><i class="bi bi-lock"></i></span>
                        <input type="password" name="password" id="password" class="form-control" autocomplete="current-password" required placeholder="••••••••••">
                    </div>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="_remember_me" id="remember_me">
                        <label class="form-check-label small" for="remember_me">Rester connecté</label>
                    </div>
                </div>
                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">
                <button class="btn btn-primary w-100 py-2" type="submit">
                    Se connecter <i class="bi bi-arrow-right ms-1"></i>
                </button>
            </form>

            <p class="small text-body-secondary mt-4 mb-0">
                Mot de passe oublié ? Contactez l'administrateur de votre société.
            </p>
            <hr class="my-4">
            <div class="cipaie-mention">
                <img src="{{ asset('images/cipaie-icone.png') }}" alt="">
                Une plateforme <strong class="ms-1">Côte d'Ivoire Paie</strong>
            </div>
        </div>
    </section>
</div>
{% endblock %}
