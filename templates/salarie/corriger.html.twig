{% extends 'layout/app.html.twig' %}
{% import 'salarie/_macros.html.twig' as m %}

{% set devise = affectation.societe.deviseEffective %}
{% block title %}Corriger une rémunération{% endblock %}
{% block page_subtitle %}{{ affectation.salarie.nomComplet }} — ligne du {{ remuneration.dateEffet|date('d/m/Y') }} ({{ remuneration.motif.libelle }}){% endblock %}
{% block breadcrumb %}{% include 'salarie/_fil.html.twig' with {etape: 'Corriger'} %}{% endblock %}

{% block content %}
<div class="row">
    <div class="col-lg-7">
        <div class="alert alert-warning d-flex gap-2">
            <i class="bi bi-exclamation-triangle"></i>
            <div>À utiliser uniquement pour une <strong>erreur de saisie</strong>. Une augmentation doit être enregistrée avec « Revaloriser » pour conserver l'historique. La correction est tracée (auteur et date).</div>
        </div>
        <div class="card">
            <div class="card-body">
                <p class="small text-body-secondary">Montants actuellement enregistrés : base {{ m.montant(remuneration.salaireBase, devise) }}, sursalaire {{ m.montant(remuneration.sursalaire, devise) }}.</p>
                {{ form_start(form) }}
                    {{ form_errors(form) }}
                    <div class="row">
                        <div class="col-md-6">{{ form_row(form.salaireBase) }}</div>
                        <div class="col-md-6">{{ form_row(form.sursalaire) }}</div>
                        <div class="col-12">{{ form_row(form.commentaire) }}</div>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-warning">Enregistrer la correction</button>
                        <a href="{{ path('app_salarie_voir', {id: affectation.id, _fragment: 'remuneration'}) }}" class="btn btn-light-subtle">Annuler</a>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
