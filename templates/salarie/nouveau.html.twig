{% extends 'layout/app.html.twig' %}

{% block title %}Nouveau salarié{% endblock %}
{% block page_subtitle %}Embauche dans <strong>{{ societe.raisonSociale }}</strong> — montants en {{ societe.deviseEffective }}.{% endblock %}
{% block breadcrumb %}<li class="breadcrumb-item"><a href="{{ path('app_salarie') }}">Salariés</a></li><li class="breadcrumb-item active">Nouveau</li>{% endblock %}

{% import 'salarie/_avantages_form.html.twig' as avantages_form %}

{% block content %}
{{ form_start(form) }}
{{ form_errors(form) }}
{% set s = form.salarie %}
{% set a = form.affectation %}
<div class="row g-3">
    <div class="col-xl-8">
        <div class="card mb-3">
            <div class="card-header"><h2 class="card-title"><i class="bi bi-person me-2 text-primary"></i>Identité</h2></div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-5">{{ form_row(s.nom) }}</div>
                    <div class="col-md-5">{{ form_row(s.prenoms) }}</div>
                    <div class="col-md-2">{{ form_row(s.sexe) }}</div>
                    <div class="col-md-4">{{ form_row(s.dateNaissance) }}</div>
                    <div class="col-md-4">{{ form_row(s.lieuNaissance) }}</div>
                    <div class="col-md-4">{{ form_row(s.nationalite) }}</div>
                    <div class="col-md-4">{{ form_row(s.situationFamiliale) }}</div>
                    <div class="col-md-4">{{ form_row(s.nombreEnfants) }}</div>
                    <div class="col-md-4">{{ form_row(s.numeroPiece) }}</div>
                </div>
                <hr class="my-3">
                <div class="row">
                    <div class="col-md-4">{{ form_row(s.telephone) }}</div>
                    <div class="col-md-8">{{ form_row(s.email) }}</div>
                    {% if s.zoneTransport is defined %}<div class="col-md-7">{{ form_row(s.adresse) }}</div><div class="col-md-5">{{ form_row(s.zoneTransport) }}</div>{% else %}<div class="col-12">{{ form_row(s.adresse) }}</div>{% endif %}
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header"><h2 class="card-title"><i class="bi bi-briefcase me-2 text-primary"></i>Poste & contrat</h2></div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4">{{ form_row(a.matricule) }}</div>
                    <div class="col-md-4">{{ form_row(a.dateEntree) }}</div>
                    <div class="col-md-4">{{ form_row(a.typeContrat) }}</div>
                    <div class="col-md-4">{{ form_row(a.metier) }}</div>
                    <div class="col-md-4">{{ form_row(a.poste) }}</div>
                    <div class="col-md-4">{{ form_row(a.service) }}</div>
                    <div class="col-md-3">{{ form_row(a.categorie) }}</div>
                    <div class="col-md-3">{{ form_row(a.echelon) }}</div>
                    <div class="col-md-3">{{ form_row(a.site) }}</div>
                    <div class="col-md-3">{{ form_row(a.dateFinContrat) }}</div>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">
                <h2 class="card-title"><i class="bi bi-gift me-2 text-primary"></i>Éléments de salaire fixes (avantages)</h2>
            </div>
            <div class="card-body pt-2">
                <p class="small text-body-secondary mb-2">Avantages liés au poste, versés chaque mois à partir de la date d'embauche. Chacun correspond à une rubrique du bulletin, qui détermine son traitement social et fiscal.</p>
                {{ avantages_form.bloc(form.avantages, 'liste-avantages', form.avantages.vars.prototype.rubrique.vars.choices is not empty) }}
            </div>
        </div>

        <div class="card">
            <div class="card-header"><h2 class="card-title"><i class="bi bi-bank me-2 text-primary"></i>Organismes & paiement</h2></div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">{{ form_row(s.numeroSecuriteSociale) }}</div>
                    <div class="col-md-6">{{ form_row(s.numeroAssuranceMaladie) }}</div>
                    <div class="col-md-4">{{ form_row(s.modePaiement) }}</div>
                    <div class="col-md-4">{{ form_row(s.banque) }}</div>
                    <div class="col-md-4">{{ form_row(s.numeroCompte) }}</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-4">
        <div class="card position-sticky" style="top: calc(var(--bp-topbar-height) + 1rem);">
            <div class="card-header"><h2 class="card-title"><i class="bi bi-cash-stack me-2 text-success"></i>Rémunération de départ</h2></div>
            <div class="card-body">
                {{ form_row(form.salaireBase) }}
                {{ form_row(form.sursalaire) }}
                <p class="small text-body-secondary">Point de départ de l'historique des salaires, à la date d'entrée. Les revalorisations s'ajouteront ensuite depuis la fiche du salarié.</p>
                <button class="btn btn-primary w-100"><i class="bi bi-check2 me-1"></i>Enregistrer le salarié</button>
                <a href="{{ path('app_salarie') }}" class="btn btn-light-subtle w-100 mt-2">Annuler</a>
            </div>
        </div>
    </div>
</div>
{{ form_end(form) }}
{% endblock %}
