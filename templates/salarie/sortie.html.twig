{% extends 'layout/app.html.twig' %}

{% block title %}Enregistrer une sortie{% endblock %}
{% block page_subtitle %}{{ affectation.salarie.nomComplet }} · entré(e) le {{ affectation.dateEntree|date('d/m/Y') }}{% endblock %}
{% block breadcrumb %}{% include 'salarie/_fil.html.twig' with {etape: 'Sortie'} %}{% endblock %}

{% block content %}
<div class="row">
    <div class="col-lg-7">
        <div class="alert alert-info d-flex gap-2">
            <i class="bi bi-info-circle"></i>
            <div>Le dossier passera en lecture seule et les avantages en cours seront arrêtés à la date de sortie. Tout l'historique est conservé.
                Pour un départ vers une autre société du groupe, utilisez plutôt <a href="{{ path('app_salarie_transferer', {id: affectation.id}) }}">le transfert</a>.</div>
        </div>
        <div class="card">
            <div class="card-body">
                {{ form_start(form, {attr: {'data-confirm': 'Confirmer la sortie de ' ~ affectation.salarie.nomComplet ~ ' ?'}}) }}
                    {{ form_errors(form) }}
                    <div class="row">
                        <div class="col-md-6">{{ form_row(form.date) }}</div>
                        <div class="col-md-6">{{ form_row(form.motif) }}</div>
                        <div class="col-12">{{ form_row(form.commentaire) }}</div>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-danger">Enregistrer la sortie</button>
                        <a href="{{ path('app_salarie_voir', {id: affectation.id}) }}" class="btn btn-light-subtle">Annuler</a>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
