{% extends 'layout/app.html.twig' %}

{% block title %}Modifier la succursale{% endblock %}
{% block breadcrumb %}<li class="breadcrumb-item"><a href="{{ path('app_succursale_voir', {id: succursale.id}) }}">{{ succursale.nom }}</a></li><li class="breadcrumb-item active">Modifier</li>{% endblock %}

{% block content %}
<div class="card" style="max-width: 720px;">
    <div class="card-body">
        {{ form_start(form) }}
            {{ form_row(form.nom) }}
            {{ form_row(form.description) }}
            <div class="d-flex gap-2">
                <button class="btn btn-primary">Enregistrer</button>
                <a href="{{ path('app_succursale_voir', {id: succursale.id}) }}" class="btn btn-light-subtle">Annuler</a>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
