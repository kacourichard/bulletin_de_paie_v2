{% extends 'layout/app.html.twig' %}

{% block title %}Ajouter un administrateur{% endblock %}
{% block page_subtitle %}Il aura tous les droits sur les sociétés de <strong>{{ succursale.nom }}</strong>.{% endblock %}
{% block breadcrumb %}<li class="breadcrumb-item"><a href="{{ path('app_succursale_voir', {id: succursale.id}) }}">{{ succursale.nom }}</a></li><li class="breadcrumb-item active">Ajouter un administrateur</li>{% endblock %}

{% block content %}
<div class="card" style="max-width: 720px;">
    <div class="card-body">
        {{ form_start(form) }}
            {{ form_errors(form) }}
            {{ form_row(form.email) }}
            <div class="row">
                <div class="col-md-6">{{ form_row(form.prenoms) }}</div>
                <div class="col-md-6">{{ form_row(form.nom) }}</div>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-primary"><i class="bi bi-person-plus me-1"></i>Ajouter</button>
                <a href="{{ path('app_succursale_voir', {id: succursale.id}) }}" class="btn btn-light-subtle">Annuler</a>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
