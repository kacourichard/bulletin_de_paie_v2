{% extends 'layout/app.html.twig' %}

{% block title %}{{ succursale.nom }}{% endblock %}
{% block page_subtitle %}
    {% if not succursale.active %}<span class="badge text-bg-secondary badge-soft">Désactivée</span>{% endif %}
    {{ succursale.description ?: 'Succursale' }} ·
    {{ succursale.societes|length }} société{{ succursale.societes|length > 1 ? 's' }} ·
    {% set total_salaries = succursale.societes|reduce((t, so) => t + (effectifs[so.id] ?? 0), 0) %}
    {{ total_salaries }} salarié{{ total_salaries > 1 ? 's' }} en poste
    {% for p in succursale.pays %}{{ loop.first ? ' · ' }}{{ p.drapeau }}{% endfor %}
{% endblock %}
{% block breadcrumb %}
    {% if is_granted('ROLE_SUPER_ADMIN') %}<li class="breadcrumb-item"><a href="{{ path('app_plateforme_succursales') }}">Succursales</a></li>{% endif %}
    <li class="breadcrumb-item active">{{ succursale.nom }}</li>
{% endblock %}
{% block page_actions %}
    <a href="{{ path('app_succursale_modifier', {id: succursale.id}) }}" class="btn btn-light-subtle"><i class="bi bi-pencil me-1"></i>Modifier</a>
    {% if is_granted('ROLE_SUPER_ADMIN') %}
        <form method="post" action="{{ path('app_plateforme_succursale_statut', {id: succursale.id}) }}" data-confirm="{{ succursale.active ? 'Désactiver cette succursale ? Ses administrateurs perdront l\'accès à ses sociétés.' : 'Réactiver cette succursale ?' }}">
            <input type="hidden" name="_token" value="{{ csrf_token('succursale-' ~ succursale.id) }}">
            <button class="btn btn-light-subtle {{ succursale.active ? 'text-danger' }}"><i class="bi bi-power me-1"></i>{{ succursale.active ? 'Désactiver' : 'Réactiver' }}</button>
        </form>
    {% endif %}
    <a href="{{ path('app_succursale_societe_nouvelle', {id: succursale.id}) }}" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Nouvelle société</a>
{% endblock %}

{% block content %}
<div class="row g-3">
    <div class="col-xl-8">
        <h2 class="h6 text-body-secondary text-uppercase mb-3" style="letter-spacing: .05em;">Sociétés</h2>
        <div class="row g-3">
            {% for s in succursale.societes %}
                {% set equipe = s.membres|filter(m => m.actif) %}
                <div class="col-md-6">
                    <div class="card h-100{{ not s.active ? ' opacity-50' }}">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex align-items-start gap-3 mb-3">
                                {% include 'societe/_logo.html.twig' with {societe: s, taille: 'lg'} %}
                                <div class="flex-grow-1 overflow-hidden">
                                    <div class="fw-semibold text-truncate">{{ s.raisonSociale }}</div>
                                    <div class="small text-body-secondary">{{ s.pays.drapeau }} {{ s.pays.nom }}{% if s.ville %} · {{ s.ville }}{% endif %} · {{ s.deviseEffective }}</div>
                                    {% if not s.active %}<span class="badge text-bg-secondary badge-soft">Inactive</span>{% endif %}
                                </div>
                            </div>
                            <div class="d-flex gap-4 small mb-3">
                                <div><div class="text-body-secondary">Salariés</div><div class="fw-semibold fs-5">{{ effectifs[s.id] ?? 0 }}</div></div>
                                <div><div class="text-body-secondary">Équipe</div><div class="fw-semibold fs-5">{{ equipe|length }}</div></div>
                            </div>
                            <div class="small flex-grow-1 mb-3">
                                {% for role_code in ['RH', 'COMPTABLE', 'TRESORIER'] %}
                                    {% set role = s.roleParCode(role_code) %}
                                    {% if role %}
                                        {% set titulaires = equipe|filter(m => m.role.id == role.id)|map(m => m.user.nomComplet) %}
                                        <div class="d-flex justify-content-between gap-2 py-1 border-bottom">
                                            <span class="badge text-bg-{{ role.couleur }} badge-soft">{{ role.libelle }}</span>
                                            <span class="text-truncate {{ titulaires|length ? '' : 'text-warning-emphasis' }}">{{ titulaires|length ? titulaires|join(', ') : 'À pourvoir' }}</span>
                                        </div>
                                    {% endif %}
                                {% endfor %}
                            </div>
                            {% if s.active %}
                                <div class="d-flex gap-2">
                                    {% for cible, libelle in {app_dashboard: 'Ouvrir', app_equipe: 'Gérer l\'équipe'} %}
                                        <form method="post" action="{{ path('app_succursale_societe_ouvrir', {id: succursale.id, societe: s.id}) }}" class="{{ loop.first ? 'flex-grow-1' }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('ouvrir-' ~ s.id) }}">
                                            <input type="hidden" name="vers" value="{{ cible }}">
                                            <button class="btn btn-sm {{ loop.first ? 'btn-primary w-100' : 'btn-light-subtle' }}">{{ libelle }}</button>
                                        </form>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12">
                    <div class="card"><div class="empty-state">
                        <i class="bi bi-buildings"></i>
                        Aucune société dans cette succursale.
                        <div class="mt-3"><a href="{{ path('app_succursale_societe_nouvelle', {id: succursale.id}) }}" class="btn btn-primary btn-sm">Créer la première société</a></div>
                    </div></div>
                </div>
            {% endfor %}
        </div>
    </div>

    <div class="col-xl-4">
        <div class="card">
            <div class="card-header">
                <h2 class="card-title"><i class="bi bi-shield-lock me-1 text-danger"></i>Administrateurs</h2>
                <a href="{{ path('app_succursale_admin_ajouter', {id: succursale.id}) }}" class="btn btn-sm btn-light-subtle"><i class="bi bi-plus-lg"></i> Ajouter</a>
            </div>
            <ul class="list-group list-group-flush">
                {% for u in succursale.administrateurs %}
                    <li class="list-group-item d-flex align-items-center gap-2 py-3">
                        <span class="avatar">{{ u.initiales }}</span>
                        <div class="flex-grow-1 overflow-hidden">
                            <div class="fw-medium">{{ u.nomComplet }}{% if u.id == app.user.id %} <span class="badge text-bg-light border badge-soft">Vous</span>{% endif %}</div>
                            <div class="small text-body-secondary text-truncate">{{ u.email }}</div>
                            {% if not u.actif %}<span class="badge text-bg-danger badge-soft">Compte désactivé</span>{% endif %}
                            {% if u.doitChangerMotDePasse %}<div class="small text-warning-emphasis"><i class="bi bi-hourglass-split"></i> Première connexion en attente</div>{% endif %}
                        </div>
                        {% if succursale.administrateurs|length > 1 %}
                            <form method="post" action="{{ path('app_succursale_admin_retirer', {id: succursale.id, user: u.id}) }}" data-confirm="Retirer {{ u.nomComplet }} des administrateurs de la succursale ?">
                                <input type="hidden" name="_token" value="{{ csrf_token('admin-' ~ succursale.id ~ '-' ~ u.id) }}">
                                <button class="btn btn-sm btn-light-subtle btn-icon text-danger" title="Retirer"><i class="bi bi-x-lg"></i></button>
                            </form>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
            <div class="card-body border-top small text-body-secondary">
                Les administrateurs ont tous les droits sur toutes les sociétés de la succursale : création de sociétés, utilisateurs, rôles, salariés, paie.
            </div>
        </div>
    </div>
</div>
{% endblock %}
