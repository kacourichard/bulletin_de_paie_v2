{% extends 'layout/app.html.twig' %}

{% set peut_exporter = is_granted('etat.exporter') %}

{% block title %}États de paie{% endblock %}
{% block page_title %}États de paie{% endblock %}
{% block page_subtitle %}{{ societe.raisonSociale }} · livre de paie, état des rubriques, bordereau des salaires et fiche individuelle, imprimables et exportables en Excel.{% endblock %}
{% block breadcrumb %}<li class="breadcrumb-item active">États de paie</li>{% endblock %}

{% macro plage(du, au) %}
    <div class="row g-2 mb-3">
        <div class="col-6">
            <label class="form-label small">Du mois</label>
            <input type="month" name="du" value="{{ du|date('Y-m') }}" class="form-control" required>
        </div>
        <div class="col-6">
            <label class="form-label small">Au mois</label>
            <input type="month" name="au" value="{{ au|date('Y-m') }}" class="form-control" required>
        </div>
    </div>
{% endmacro %}

{% macro boutons(peut_exporter) %}
    <div class="d-flex gap-2 mt-auto">
        <button class="btn btn-primary" name="format" value=""><i class="bi bi-printer me-1"></i>Afficher / imprimer</button>
        {% if peut_exporter %}<button class="btn btn-light-subtle" name="format" value="xlsx"><i class="bi bi-file-earmark-excel me-1 text-success"></i>Excel</button>{% endif %}
    </div>
{% endmacro %}

{% block content %}
<div class="alert alert-info d-flex gap-2 small">
    <i class="bi bi-info-circle"></i>
    <div>Les états reprennent les bulletins des mois dont la paie est ouverte. Un mois non encore validé y figure avec la mention <strong>provisoire</strong>.</div>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <form class="card h-100" method="get" action="{{ path('app_etat_livre') }}" target="_blank">
            <div class="card-body d-flex flex-column">
                <h2 class="h6 mb-1"><i class="bi bi-journal-text me-2 text-primary"></i>Livre de paie</h2>
                <p class="small text-body-secondary">Une ligne par salarié et par mois : gains, brut, impôt et cotisations salariales, net à payer, charges patronales et coût employeur, avec totaux mensuels.</p>
                {{ _self.plage(du, au) }}
                {{ _self.boutons(peut_exporter) }}
            </div>
        </form>
    </div>

    <div class="col-lg-6">
        <form class="card h-100" method="get" action="{{ path('app_etat_rubriques') }}" target="_blank">
            <div class="card-body d-flex flex-column">
                <h2 class="h6 mb-1"><i class="bi bi-list-columns-reverse me-2 text-primary"></i>État des rubriques</h2>
                <p class="small text-body-secondary">Total de chaque rubrique sur la période : gains, retenues salariales et part patronale.</p>
                {{ _self.plage(du, au) }}
                <div class="mb-3">
                    <label class="form-label small">Salariés</label>
                    <select name="nationalite" class="form-select">
                        <option value="">Tous</option>
                        <option value="nationaux">Nationaux ({{ national.nom }})</option>
                        <option value="non-nationaux">Non nationaux (expatriés)</option>
                    </select>
                </div>
                {{ _self.boutons(peut_exporter) }}
            </div>
        </form>
    </div>

    <div class="col-lg-6">
        <form class="card h-100" method="get" action="{{ path('app_etat_bordereau') }}" target="_blank">
            <div class="card-body d-flex flex-column">
                <h2 class="h6 mb-1"><i class="bi bi-bank me-2 text-primary"></i>Bordereau des salaires</h2>
                <p class="small text-body-secondary">Nets à payer par banque (ou par chèque / espèces), arrêtés en lettres, à remettre à la banque avec l'ordre de paiement.</p>
                {{ _self.plage(du, au) }}
                <div class="mb-3">
                    <label class="form-label small">Banque</label>
                    <select name="banque" class="form-select">
                        <option value="">Toutes (un bordereau par banque)</option>
                        {% for b in banques %}<option value="{{ b }}">{{ b }}</option>{% endfor %}
                    </select>
                </div>
                {{ _self.boutons(peut_exporter) }}
            </div>
        </form>
    </div>

    <div class="col-lg-6">
        <form class="card h-100" method="get" action="{{ path('app_etat_fiche_choisir') }}" target="_blank">
            <div class="card-body d-flex flex-column">
                <h2 class="h6 mb-1"><i class="bi bi-person-lines-fill me-2 text-primary"></i>Fiche individuelle</h2>
                <p class="small text-body-secondary">Les rubriques d'un salarié mois par mois sur une année, avec cumuls annuels (brut, net, charges).</p>
                <div class="row g-2 mb-3">
                    <div class="col-8">
                        <label class="form-label small">Salarié</label>
                        <select name="salarie" class="form-select" required data-controller="liste-recherche">
                            <option value="">— Choisir —</option>
                            {% for a in salaries %}<option value="{{ a.id }}">{{ a.salarie.nomComplet }} ({{ a.matricule }}){{ a.dateSortie ? ' — sorti(e)' }}</option>{% endfor %}
                        </select>
                    </div>
                    <div class="col-4">
                        <label class="form-label small">Année</label>
                        <input type="number" name="annee" value="{{ annee }}" min="2000" max="2100" class="form-control" required
                               onchange="window.location = '{{ path('app_etats') }}?annee=' + this.value">
                    </div>
                </div>
                {% if salaries is empty %}<p class="small text-warning-emphasis">Aucun salarié présent en {{ annee }}.</p>{% endif %}
                {{ _self.boutons(peut_exporter) }}
            </div>
        </form>
    </div>
</div>
{% endblock %}
